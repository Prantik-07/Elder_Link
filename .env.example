# ElderLink Day 1 - Audio Transcription Pipeline
# These are the env vars actually read by backend/lambdas/process_audio/handler.py
# and backend/core/transcription/voxtral.py. In the deployed Lambda they are
# set via infra/template.yaml, not by this file - this file is for running
# backend/scripts/test_transcription.py locally.

# Which TranscriptionProvider to use: "mock" (default, deterministic, no AWS
# Bedrock access needed) or "voxtral" (real Amazon Bedrock Voxtral inference).
TRANSCRIPTION_PROVIDER=mock

# Region for the S3/Bedrock clients. Named ELDERLINK_AWS_REGION (not
# AWS_REGION) because AWS_REGION is a reserved Lambda environment variable
# that cannot be set via CloudFormation's Environment.Variables.
ELDERLINK_AWS_REGION=us-east-1

# Amazon Bedrock model ID for the Voxtral speech-to-text provider.
BEDROCK_MODEL_ID=mistral.voxtral-mini-3b-2507

# S3 bucket used for both audio/ uploads and transcripts/ output.
AUDIO_BUCKET_NAME=elderlink-audio-pipeline-audiobucket-d4embqdcnuoi

# Reject audio objects larger than this many bytes.
MAX_AUDIO_SIZE_BYTES=10485760

# NOTE: Care Event extraction, DynamoDB, and API Gateway are not part of
# Day 1 and have no environment variables here yet.
