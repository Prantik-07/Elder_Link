# AWS Configuration
AWS_REGION=us-east-1

# S3
S3_BUCKET_NAME=elderlink-audio-uploads

# DynamoDB
DYNAMODB_TABLE_NAME=elderlink-care-events

# API Gateway
API_BASE_URL=https://api.example.com

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Transcribe
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_OUTPUT_BUCKET=elderlink-transcribe-output