# Base URL of the deployed CareEvents read API (see infra/template.yaml's
# CareEventsApiUrl output, or `sam list stack-outputs`). Left unset, the
# frontend has no real API to call - see VITE_ELDERLINK_USE_MOCK_DATA below
# for what happens then.
VITE_ELDERLINK_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# The demo care recipient whose timeline the frontend loads. Matches the
# backend's DEFAULT_CARE_RECIPIENT_ID (see the root .env.example) - a
# hackathon-demo simplification, not a real patient-selection feature.
VITE_ELDERLINK_CARE_RECIPIENT_ID=demo-dad

# Set to "true" to use frontend/src/data/mockEvents.ts instead of calling
# the API - for local UI work with no backend deployed. Never a silent
# fallback: if this is unset/false and the API call fails, the app shows an
# error state rather than quietly substituting mock data (see
# CareEventsContext.tsx).
VITE_ELDERLINK_USE_MOCK_DATA=false
